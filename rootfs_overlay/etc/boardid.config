# boardid.config

# Read the H700's SID eFuse.
#
# The H616/H700 SID is described in sun50i-h616.dtsi as
# efuse@3006000 with compatible "allwinner,sun50i-h616-sid", and the
# sunxi-sid driver exposes it as nvmem device sunxi-sid0. Anbernic does
# not document how these eFuses are programmed, so treat this as
# "stable per device" rather than "globally unique" -- if two units ever
# collide, set NERVES_SERIAL_NUMBER at burn time instead (see
# fwup_include/provisioning.conf).
-b binfile -f /sys/bus/nvmem/devices/sunxi-sid0/nvmem -l 16 -k 0
