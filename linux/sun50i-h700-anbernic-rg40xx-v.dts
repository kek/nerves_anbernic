// SPDX-FileCopyrightText: Philippe Simons <lhy31@gmail.com>
// SPDX-FileCopyrightText: Ryan Walklin <ryan@testtoast.com>
// SPDX-FileCopyrightText: Chris Morgan <macromorgan@hotmail.com>
// SPDX-FileCopyrightText: 2026 Karl Eklund
/*
 * Device tree for the Anbernic RG40XX V (Allwinner H700).
 *
 * Derived from the ROCKNIX/Batocera sun50i-h700-anbernic-rg40xx-v.dts by
 * Philippe Simons, itself extending mainline rg35xx-plus.dts by Ryan Walklin
 * and Chris Morgan. Dual-licensed as upstream, so this header is authoritative
 * and REUSE.toml does not annotate this file.
 *
 * The RG40XX V is the same PCB family as the RG35XX Plus, so nearly
 * everything is inherited: the AXP717 PMIC and its regulator tree,
 * battery and USB power supplies, mmc0, the gamepad and volume buttons
 * as gpio-keys, LEDs, the audio codec, USB, and the RTL8821CS SDIO
 * WiFi + UART Bluetooth that rg35xx-plus.dts adds on top of
 * rg35xx-2024.dts.
 *
 * NOTE ON THE INCLUDE PATH: this file is built via Buildroot's
 * BR2_LINUX_KERNEL_CUSTOM_DTS_PATH, which copies it into
 * arch/arm64/boot/dts/ (flat) rather than into the allwinner/
 * subdirectory. Hence the "allwinner/" prefix below. cpp resolves
 * nested includes relative to the including file's own directory, so
 * rg35xx-plus.dts still finds sun50i-h616.dtsi normally. Building this
 * as a genuine in-tree file would drop the prefix.
 *
 * DISPLAY. Everything from the display engine down to the panel is
 * described here rather than as a patch against sun50i-h616.dtsi, even
 * though the H616 nodes are SoC-level and upstream would put them
 * there. Two reasons: a rejected hunk on a kernel bump is a much worse
 * failure than a merge conflict in a file we own, and keeping it here
 * means tools/check-dts.sh sees the whole pipeline as source.
 *
 * There are two output paths, and they share one display engine:
 *
 *     mixer0 -> tcon_top -> tcon_lcd0 -> panel  (RGB888 + SPI init)
 *                        \-> tcon_tv0 -> hdmi -> mini-HDMI connector
 *
 * There is no mixer1. That is not an omission, it is what 6.18.44
 * allows: DE33's plane registers are a single block at 0x100000 shared
 * by both mixers, upstream's mixer binding claims that block as the
 * mixer's own reg index 0 with devm_platform_ioremap_resource(), and a
 * second mixer node asking for the same window fails with -EBUSY. The
 * split that makes two mixers possible -- a separate planes driver both
 * mixers point at -- is exactly the refactor still in review on
 * dri-devel, and taking it would mean reverting the DE33 plane code
 * 6.18.44 already has. See docs/display.md.
 *
 * The consequence is a hard one and worth stating in the device tree
 * rather than only in prose: THE PANEL AND HDMI CANNOT BE ON AT THE
 * SAME TIME. Both CRTCs resolve to mixer0, TCON_TOP_PORT_SEL routes
 * that mixer to one TCON at a time, and lighting both is not mirroring
 * -- it is two CRTCs writing one set of channel registers.
 *
 * The drivers this needs are in patches/linux/0100..0105. 6.18.44
 * already has the DE33 mixer and its clocks, so the mixer node follows
 * upstream's binding -- reg-names "layers", "top", "display" -- and not
 * ROCKNIX's, which splits the layer registers into a separate planes@
 * node for a driver we deliberately do not carry. See 0100's header.
 */

#include "allwinner/sun50i-h700-anbernic-rg35xx-plus.dts"

#include <dt-bindings/clock/sun8i-de2.h>
#include <dt-bindings/clock/sun8i-tcon-top.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/reset/sun8i-de2.h>

/ {
	model = "Anbernic RG40XX V";

	/*
	 * Downstream trees (ROCKNIX, Batocera) spell this "anbernic,rg40xx-V"
	 * with a capital V. Lowercase here to match kernel conventions;
	 * nothing in a Nerves image matches on the string.
	 */
	compatible = "anbernic,rg40xx-v", "allwinner,sun50i-h700";

	/*
	 * Backlight enable on PD28, as a plain GPIO rather than PWM.
	 *
	 * PD28 is the right pin, confirmed from two independent directions:
	 * muOS's vendor DT for this exact device sets lcd_pwm_ch = 0 and
	 * muxes pwm0 onto PD28, and 6.18.44's pinctrl-sun50i-h616.c makes
	 * PD28 the only pin in the SoC carrying a pwm0 function. ROCKNIX
	 * uses PD28 too. (The PI13 and PH2 pins that the panel spec notes
	 * as differing between muOS DTBs are pwm3 and pwm2 -- they are not
	 * the backlight.)
	 *
	 * The backlight is really PWM-driven -- muOS at 50 kHz, ROCKNIX at
	 * 25 kHz -- but the H616 PWM controller has no mainline driver, and
	 * carrying the out-of-tree one costs about 1900 lines of patch for
	 * brightness control alone. Holding PD28 high is full brightness
	 * and needs nothing out of tree. Swap this for pwm-backlight when
	 * brightness control is worth that patch.
	 *
	 * Active high: ROCKNIX drives this GPIO_ACTIVE_HIGH in its
	 * gpio-backlight form and passes flag 0 -- normal polarity -- in
	 * its pwm-backlight form. muOS's lcd_pwm_pol = 1 is vendor
	 * encoding and does not obviously contradict that, but it is not
	 * proof either. If the panel turns out to light up dark, this is
	 * one line: make it GPIO_ACTIVE_LOW.
	 *
	 * default-on matters: nothing in a Nerves image would otherwise
	 * turn the backlight on, and an unlit panel is indistinguishable
	 * from a broken pipeline.
	 */
	backlight: backlight {
		compatible = "gpio-backlight";
		gpios = <&pio 3 28 GPIO_ACTIVE_HIGH>; /* PD28 */
		default-on;
	};

	/*
	 * The mini-HDMI socket on the top edge.
	 *
	 * type is informational -- nothing in the driver path reads it -- and
	 * the sources disagree: ROCKNIX spells this family "d" (micro) while
	 * Anbernic's own listing for the RG40XX V says mini, which is "c".
	 * The socket on this shell is the mini one, so "c".
	 *
	 * No hpd-gpios and no ddc-i2c-bus: hotplug detect and the DDC lines
	 * are inside the HDMI controller on this SoC, not brought out to
	 * GPIOs, so dw-hdmi reads both itself.
	 */
	connector {
		compatible = "hdmi-connector";
		type = "c";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	de: display-engine {
		compatible = "allwinner,sun50i-h616-display-engine";
		allwinner,pipelines = <&mixer0>;
	};

	/* Panel 3V3. Not a PMIC rail -- a load switch on PI15. */
	reg_lcd: regulator-lcd {
		compatible = "regulator-fixed";
		regulator-name = "vdd-lcd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pio 8 15 GPIO_ACTIVE_HIGH>; /* PI15 */
		enable-active-high;
	};

	/*
	 * The panel's command channel: three-wire SPI, bit-banged on GPIO.
	 * There is no hardware SPI controller wired to the panel, so this
	 * needs CONFIG_SPI_GPIO.
	 */
	spi_lcd: spi {
		compatible = "spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;

		sck-gpios = <&pio 8 9 GPIO_ACTIVE_HIGH>;  /* PI9 */
		mosi-gpios = <&pio 8 10 GPIO_ACTIVE_HIGH>; /* PI10 */
		cs-gpios = <&pio 8 8 GPIO_ACTIVE_HIGH>;   /* PI8 */
		num-chipselects = <1>;

		/*
		 * The first compatible string is not decoration: the driver
		 * builds a firmware filename from it and loads
		 * /lib/firmware/panels/anbernic,rg40xx-panel.panel, which is
		 * where this panel's timings AND its init sequence live.
		 * There is no panel-timing node anywhere by design.
		 *
		 * The variant, and how it was narrowed down on hardware.
		 *
		 * v1 was tried first, because muOS's vendor DT names this
		 * panel fog_fj035fhd05_v1. It gave a **blank screen with the
		 * backlight on** -- and the pipeline was demonstrably fine
		 * underneath: the connector read connected at 640x480, the
		 * blob loaded, all three components bound, and the clock tree
		 * showed tcon-data-clock running at 27 MHz. So the panel was
		 * being fed pixels and simply not displaying them, which means
		 * its controller never took the init sequence.
		 *
		 * That plus the owner's own experience -- ROCKNIX, whose
		 * rg40xx-v default is the v1 panel, showed nothing on this
		 * unit either, while muOS works -- says the vendor's "_v1" and
		 * ROCKNIX's "-v2-panel" do not refer to the same revision
		 * split. So this is v2.
		 *
		 * If this is ever wrong, the tell is unchanged: both variants
		 * report 640x480 @ 60 Hz with identical blanking, so a correct
		 * mode confirms nothing. They differ in init sequence and sync
		 * polarity. Blank or scrambled at a correct mode means the
		 * other variant; both blobs ship, and it is this one string.
		 *
		 * A note on reading the log: the v1 blob adds a second mode,
		 * 640x480 @ 120 Hz, and the v2 blob does not. Two modelines in
		 * dmesg therefore tells you which *file* was loaded -- not
		 * which panel is soldered on.
		 *
		 * What muOS independently confirms is the wiring, not the
		 * variant: its lcd_gpio_0..4 are PI9, PI10, PI8, PI14, PI15,
		 * which is exactly the SPI clock, MOSI, chip select, reset and
		 * panel supply used above.
		 *
		 * Where muOS and ROCKNIX genuinely disagree is the timings,
		 * and muOS's are the ones known to drive this hardware:
		 *
		 *   muOS (vendor)   24 MHz, total 768 x 521, hbp 46 hspw 20,
		 *                   vbp 15 vspw 4      -> 59.98 Hz
		 *   ROCKNIX (.panel) 27 MHz, total 750 x 600, hfp 64 hsync 4
		 *                   hbp 42, vfp 100 vsync 4 vbp 16 -> 60.00 Hz
		 *
		 * The blob carries the timings, so preferring muOS's would
		 * mean authoring a .panel file rather than editing the DT.
		 * That is the fallback if ROCKNIX's blob gives a picture that
		 * is present but wrong; the init sequence inside the blob
		 * cannot be got from muOS at all, since it lives in Anbernic's
		 * prebuilt vendor kernel and not in any MustardOS repository.
		 */
		panel: panel@0 {
			compatible = "anbernic,rg40xx-v2-panel", "panel-mipi-dpi-spi";
			reg = <0>;

			spi-max-frequency = <3125000>;
			spi-3wire;

			reset-gpios = <&pio 8 14 GPIO_ACTIVE_LOW>; /* PI14 */

			backlight = <&backlight>;
			power-supply = <&reg_lcd>;

			pinctrl-names = "default";
			pinctrl-0 = <&lcd0_rgb888_pins>;

			port {
				panel_in_rgb: endpoint {
					remote-endpoint = <&tcon_lcd0_out_lcd>;
				};
			};
		};
	};

	/*
	 * 3V3 for the second card slot. Not a PMIC rail: a GPIO-controlled
	 * load switch on PE4, in the same shape as reg_lcd above. Consumed
	 * by &mmc2 below; see that node for where these values come from.
	 */
	reg_vcc3v3_mmc2: regulator-vcc3v3-mmc2 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3-mmc2";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pio 4 4 GPIO_ACTIVE_HIGH>; /* PE4 */
		enable-active-high;
	};

	/*
	 * The analog stick.
	 *
	 * This board has one, and rg35xx-plus.dts -- which this file extends
	 * -- describes a board that has none. So the stick was never
	 * described at all, and Linux reported an RG40XX V with fifteen keys
	 * and no ev_abs on any input device. That is the whole of why it did
	 * not work: not a driver failing, an absence.
	 *
	 * WIRING. One ADC with a 4:1 analog multiplexer in front of it. PI1
	 * and PI2 are the select lines, PI0 enables the mux, and the selected
	 * signal arrives at the H700's GPADC on channel 0. Read out of muOS's
	 * vendor device tree for this exact device, which spells it
	 * amux-en-gpios = PI0, A0_gpio = PI1, A1_gpio = PI2 against a gpadc at
	 * 0x5070000 -- and pin for pin what mainline's rg35xx-h.dts describes
	 * for the two-stick sibling of this board.
	 *
	 * All four mux positions are declared even though one stick occupies
	 * two of them. Two select lines make four positions whether or not
	 * anything is soldered to them, and declaring them all puts every one
	 * in sysfs, which is what makes the next paragraph checkable rather
	 * than merely asserted.
	 *
	 * WHAT IS INFERRED. Which two positions the stick sits on, and which
	 * way round each axis runs, are taken from the RG35XX H's left stick:
	 * positions 0 and 1, with X inverted. Shared mux wiring makes that the
	 * obvious guess and does not make it a measurement. To settle it on
	 * hardware, move the stick while reading
	 *
	 *     /sys/bus/iio/devices/iio:device0/in_voltage[0-3]_raw
	 *
	 * The two that move are the stick; which way each one travels gives
	 * the polarity, and the extremes give the real range in place of the
	 * nominal 0..4096 below.
	 *
	 * THE CLICK is described, in a separate node further down: the stick on
	 * this board is a button as well as an axis pair. The sibling board
	 * puts BTN_THUMBL on PE8 and muOS's vendor tree calls that same pin
	 * "Key L3", and pressing it here confirms the line is real. See the
	 * gpio_keys_gamepad override below for why only the left one is
	 * described.
	 */
	adc-joystick {
		compatible = "adc-joystick";
		io-channels = <&adc_mux 0>, <&adc_mux 1>;
		pinctrl-0 = <&joy_mux_pin>;
		pinctrl-names = "default";
		poll-interval = <60>;
		#address-cells = <1>;
		#size-cells = <0>;

		axis@0 {
			reg = <0>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <4096 0>;
			linux,code = <ABS_X>;
		};

		axis@1 {
			reg = <1>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <0 4096>;
			linux,code = <ABS_Y>;
		};
	};

	adc_mux: adc-mux {
		compatible = "io-channel-mux";
		channels = "stick_x", "stick_y", "spare_2", "spare_3";
		#io-channel-cells = <1>;
		io-channels = <&gpadc 0>;
		io-channel-names = "parent";
		mux-controls = <&gpio_mux>;
		settle-time-us = <100>;
	};

	gpio_mux: mux-controller {
		compatible = "gpio-mux";
		mux-gpios = <&pio 8 1 GPIO_ACTIVE_LOW>, /* PI1 */
			    <&pio 8 2 GPIO_ACTIVE_LOW>; /* PI2 */
		#mux-control-cells = <0>;
	};
};

/*
 * The stick's click, on PE8.
 *
 * Confirmed by pressing it: the stick on this board is a button as well as
 * an axis pair. The pin is the one mainline's rg35xx-h.dts gives BTN_THUMBL
 * on the two-stick sibling, and the one muOS's vendor tree for this device
 * labels "Key L3".
 *
 * Only the left one. That board describes a BTN_THUMBR on PE9 as well, and
 * this shell has no second stick to click -- a gpio-keys entry for a switch
 * that is not fitted is an input that chatters rather than one that stays
 * quiet.
 */
&gpio_keys_gamepad {
	button-thumbl {
		label = "GPIO Thumb Left";
		gpios = <&pio 4 8 GPIO_ACTIVE_LOW>; /* PE8 */
		linux,input-type = <EV_KEY>;
		linux,code = <BTN_THUMBL>;
	};
};

/*
 * The ADC the multiplexer feeds into. Disabled in sun50i-h616.dtsi, the way
 * SoC-level nodes are, and enabled here with the one channel this board
 * physically brings out.
 */
&gpadc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
	};
};

/*
 * The RGB indicator LED. Referenced by path rather than by label
 * because mainline's rg35xx-2024.dts declares its gpio-leds node
 * without one, and adding a label would mean patching a mainline DTS
 * just to extend it.
 */
&{/leds} {
	led-rgb {
		function = LED_FUNCTION_INDICATOR;
		color = <LED_COLOR_ID_RGB>;
		gpios = <&pio 8 7 GPIO_ACTIVE_HIGH>; /* PI7 */
	};
};

/*
 * The second card slot -- the one the games card goes in.
 *
 * sun50i-h616.dtsi leaves mmc@4022000 status = "disabled" and no board in
 * the Anbernic H700 family enables it in mainline, so every property below
 * is taken from a source that describes this hardware rather than inferred
 * from the SoC. Two independent sources agree on all of them:
 *
 *   1. ROCKNIX's copy of Chris Morgan's patch "arm64: dts: allwinner: h700:
 *      Add MMC2 for Anbernic RG35XX" (Message-Id
 *      <20241018160617.157083-2-macroalpha82@gmail.com>), which is a diff
 *      against sun50i-h700-anbernic-rg35xx-2024.dts -- the file this DTS
 *      inherits from through rg35xx-plus.dts:
 *      https://github.com/ROCKNIX/distribution/blob/next/projects/ROCKNIX/devices/H700/patches/linux/0126-20241018_macroalpha82_rg35xx_add_additional_hardware_support.patch
 *
 *   2. A decompile of Anbernic's own vendor DTB for the RG40XX H, the
 *      horizontal sibling of this board:
 *      https://gist.github.com/macromorgan/c96590eb5bdad96771f26ef20bf20512
 *      Its sdmmc@04022000 node (device_type = "sdc2") has bus-width = <4>,
 *      cd-gpios on bank 4 pin 0x16, pwr-gpios on bank 4 pin 4, no-sdio and
 *      no-mmc. Bank 4 is PE, so that is PE22 and PE4 -- the same two pins
 *      Chris Morgan's patch uses. The same decompile puts mmc0's cd-gpios
 *      on bank 5 pin 6, which is the PF6 mainline already uses for the boot
 *      slot, so the bank/pin decoding is confirmed against a known-good
 *      value rather than assumed.
 *
 * That the slot is mmc2 at all is from the same decompile: its aliases give
 * sdc2 = "/soc@03000000/sdmmc@04022000" and sdc1 = ".../sdmmc@04021000",
 * and sdc1 carries no-mmc + no-sd -- SDIO only, i.e. the WiFi part.
 *
 * Not overridden, deliberately:
 *
 *   pinctrl. The dtsi's mmc2_pins is PC0, PC1, PC5, PC6, PC8-PC11 and
 *   PC13-PC16. The vendor DTB muxes exactly that set (its sdc2@0 group plus
 *   the single-pin sdc2@2 strobe group), so the default group is right and
 *   complete. Nothing else in this board's device tree touches bank PC --
 *   checked -- and rg35xx-2024.dts already supplies vcc-pc-supply, so the
 *   bank is powered. bus-width = <4> means only D0-D3 carry data; the rest
 *   of the group is muxed but idle, which is what the vendor ships too.
 *
 *   aliases. Chris Morgan's patch also adds mmc0 = &mmc0, mmc1 = &mmc2,
 *   mmc2 = &mmc1, which renumbers the *host* so the games slot is mmc1.
 *   Skipped here for two reasons. Without any mmc alias, mmc_alloc_host()
 *   allocates host indices from an IDA in probe order (drivers/mmc/core/
 *   host.c), and probe order is device tree order -- 0x4020000, 0x4021000,
 *   0x4022000 -- so the hosts already come out 0, 1, 2 with the names they
 *   have here. And the alias would not buy what it looks like it buys:
 *   mmcblkN is a *separate* IDA allocated in card-probe order in
 *   mmc_blk_alloc() (drivers/mmc/core/block.c), not derived from the host
 *   index, so no alias can pin the boot card to mmcblk0. See the note in
 *   rootfs_overlay/boot/extlinux/ about that.
 *
 * This node only makes the block device appear. It is deliberately not
 * partitioned, formatted or mounted by anything in this system -- the card
 * belongs to the user and holds their games. Mounting it is the
 * application's job.
 */
&mmc2 {
	bus-width = <4>;
	cd-gpios = <&pio 4 22 GPIO_ACTIVE_LOW>; /* PE22 */
	disable-wp;
	/*
	 * The slot is 3V3-only -- the vendor DTB sets sunxi-dis-signal-vol-sw
	 * and there is no 1V8 rail switched to it -- so never attempt a
	 * signal voltage switch to UHS.
	 */
	no-1-8-v;
	vmmc-supply = <&reg_vcc3v3_mmc2>;
	vqmmc-supply = <&reg_cldo3>;
	status = "okay";
};

/*
 * The SoC-level display blocks. /soc carries no label in
 * sun50i-h616.dtsi, so this is a path reference, same as /leds above.
 */
&{/soc} {
	/*
	 * Display Engine 3.3. Bound by drivers/bus/sun50i-de2.c through the
	 * a64-de2 fallback compatible -- without that match the children
	 * below are never populated and nothing probes.
	 */
	bus@1000000 {
		compatible = "allwinner,sun50i-h616-de33",
			     "allwinner,sun50i-a64-de2";
		reg = <0x1000000 0x400000>;
		allwinner,sram = <&de3_sram 1>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0 0x1000000 0x400000>;

		display_clocks: clock@8000 {
			compatible = "allwinner,sun50i-h616-de33-clk";
			reg = <0x8000 0x100>;
			clocks = <&ccu CLK_DE>, <&ccu CLK_BUS_DE>;
			clock-names = "mod", "bus";
			resets = <&ccu RST_BUS_DE>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		/*
		 * Three register windows, named as upstream's binding
		 * requires: "layers" is the per-channel plane registers and
		 * is also reg index 0, which is what the driver ioremaps as
		 * the engine's own regs; "top" is global control; "display"
		 * is blend control. The layer window has to be big enough to
		 * cover channel 3, which sun8i_channel_base() puts at
		 * map[3] * 0x20000 + 0x1000 = 0x101000 for this SoC.
		 */
		mixer0: mixer@100000 {
			compatible = "allwinner,sun50i-h616-de33-mixer-0";
			reg = <0x100000 0x180000>,
			      <0x8100 0x40>,
			      <0x280000 0x20000>;
			reg-names = "layers", "top", "display";
			clocks = <&display_clocks CLK_BUS_MIXER0>,
				 <&display_clocks CLK_MIXER0>;
			clock-names = "bus", "mod";
			resets = <&display_clocks RST_MIXER0>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				mixer0_out: port@1 {
					reg = <1>;

					mixer0_out_tcon_top_mixer0: endpoint {
						remote-endpoint = <&tcon_top_mixer0_in_mixer0>;
					};
				};
			};
		};
	};

	/*
	 * The HDMI controller: a Synopsys DesignWare transmitter with an
	 * Allwinner wrapper. The first compatible is what identifies the
	 * SoC; the second is what actually matches, because sun8i_dw_hdmi.c
	 * in 6.18.44 has H6 quirks and no H616 entry, and the H6 quirks are
	 * the correct ones (mode_valid rejecting nothing below 594 MHz,
	 * use_drm_infoframe). Only the PHY needed new code -- see
	 * patches/linux/0105.
	 *
	 * #sound-dai-cells is here because the binding wants it, not because
	 * audio works. HDMI audio on this SoC goes through the AHUB, whose
	 * driver is not in mainline at all; ROCKNIX ships one and keeps it
	 * disabled. See docs/display.md.
	 *
	 * No hvcc-supply. Every H616 board in Jernej's series names a 1V8
	 * rail here, but on this PCB the AXP717's aldo1/2/3 are all marked
	 * unused in rg35xx-2024.dts, and ROCKNIX ships its hvcc-supply
	 * commented out and gets a picture anyway -- so the rail is on by
	 * PMIC default. devm_regulator_get() falls back to a dummy regulator
	 * when the supply is absent, so the driver probes either way. If the
	 * port stays dark with everything else correct, aldo1 is the first
	 * thing to try: it is the rail ROCKNIX guessed at.
	 */
	hdmi: hdmi@6000000 {
		compatible = "allwinner,sun50i-h616-dw-hdmi",
			     "allwinner,sun50i-h6-dw-hdmi";
		reg = <0x06000000 0x10000>;
		reg-io-width = <1>;
		interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&ccu CLK_BUS_HDMI>, <&ccu CLK_HDMI_SLOW>,
			 <&ccu CLK_HDMI>, <&ccu CLK_HDMI_CEC>,
			 <&ccu CLK_HDCP>, <&ccu CLK_BUS_HDCP>;
		clock-names = "iahb", "isfr", "tmds", "cec", "hdcp",
			      "hdcp-bus";
		resets = <&ccu RST_BUS_HDMI>, <&ccu RST_BUS_HDCP>;
		reset-names = "ctrl", "hdcp";
		phys = <&hdmi_phy>;
		phy-names = "phy";
		#sound-dai-cells = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			hdmi_in: port@0 {
				reg = <0>;

				hdmi_in_tcon_top: endpoint {
					remote-endpoint = <&tcon_top_hdmi_out_hdmi>;
				};
			};

			hdmi_out: port@1 {
				reg = <1>;

				hdmi_out_con: endpoint {
					remote-endpoint = <&hdmi_con_in>;
				};
			};
		};
	};

	/*
	 * The HDMI PHY. Its compatible is the one thing in this pipeline
	 * that 6.18.44 cannot match at all, which is what
	 * patches/linux/0105 adds. Without that patch this node does not
	 * bind, and because sun4i-drm is a component master that takes down
	 * the whole display -- the panel included.
	 */
	hdmi_phy: hdmi-phy@6010000 {
		compatible = "allwinner,sun50i-h616-hdmi-phy";
		reg = <0x06010000 0x10000>;
		clocks = <&ccu CLK_BUS_HDMI>, <&ccu CLK_HDMI_SLOW>;
		clock-names = "bus", "mod";
		resets = <&ccu RST_BUS_HDMI_SUB>;
		reset-names = "phy";
		#phy-cells = <0>;
	};

	tcon_top: tcon-top@6510000 {
		compatible = "allwinner,sun50i-h616-tcon-top",
			     "allwinner,sun50i-h6-tcon-top";
		reg = <0x06510000 0x1000>;
		clocks = <&ccu CLK_BUS_TCON_TOP>,
			 <&ccu CLK_TCON_TV0>;
		clock-names = "bus", "tcon-tv0";
		clock-output-names = "tcon-top-tv0";
		resets = <&ccu RST_BUS_TCON_TOP>;
		#clock-cells = <1>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * The input endpoint can stay unnumbered, because the
			 * only thing that reads it is sun8i_mixer_of_get_id(),
			 * which goes through of_graph_parse_endpoint() and so
			 * defaults a missing reg to 0.
			 *
			 * The OUTPUT endpoint must carry an explicit reg, and
			 * it is the TCON index rather than a port number. The
			 * two are read by different code:
			 * sun4i_tcon_of_get_id_from_port() calls
			 * of_property_read_u32(remote, "reg") directly, with no
			 * default. Omitting it made that return -EINVAL, and
			 * nothing checks the sign -- sun8i_tcon_top_de_config()
			 * only rejects tcon > 3, so -22 reached
			 * FIELD_PREP(TCON_TOP_PORT_DE0_MSK, ...) and its two-bit
			 * mask turned it into 2. TCON_TOP_PORT_SEL then routed
			 * mixer0 to TCON2 while the panel hangs off TCON0, and
			 * the panel showed a constant colour while the display
			 * engine never completed a frame. Confirmed on hardware:
			 * PORT_SEL read 0x22 against a working muOS's 0x20, and
			 * correcting it live made the screen show the console.
			 *
			 * So reg = <0> here means TCON0 = tcon_lcd0. This is
			 * what ROCKNIX encodes with its endpoint@0/endpoint@2
			 * numbering.
			 */
			tcon_top_mixer0_in: port@0 {
				reg = <0>;

				tcon_top_mixer0_in_mixer0: endpoint {
					remote-endpoint = <&mixer0_out_tcon_top_mixer0>;
				};
			};

			/*
			 * Two endpoints, and the reg on each is the TCON index
			 * -- 0 is tcon_lcd0, 2 is tcon_tv0. Same numbering as
			 * ROCKNIX. Both are described, but only one can be
			 * carrying pixels: TCON_TOP_PORT_SEL's DE0 field names
			 * a single TCON and sun8i_tcon_top_de_config() rewrites
			 * it whenever a TCON is enabled.
			 */
			tcon_top_mixer0_out: port@1 {
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;

				tcon_top_mixer0_out_tcon_lcd0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&tcon_lcd0_in_tcon_top_mixer0>;
				};

				tcon_top_mixer0_out_tcon_tv0: endpoint@2 {
					reg = <2>;
					remote-endpoint = <&tcon_tv0_in_tcon_top_mixer0>;
				};
			};

			/*
			 * TCON TOP's own HDMI pair. Port 4 takes TCON TV0's
			 * output back in and port 5 hands it to the HDMI
			 * controller; the block sits in the middle of that path
			 * on H6-family SoCs rather than the TCON driving the
			 * transmitter directly.
			 */
			tcon_top_hdmi_in: port@4 {
				reg = <4>;

				tcon_top_hdmi_in_tcon_tv0: endpoint {
					remote-endpoint = <&tcon_tv0_out_tcon_top>;
				};
			};

			tcon_top_hdmi_out: port@5 {
				reg = <5>;

				tcon_top_hdmi_out_hdmi: endpoint {
					remote-endpoint = <&hdmi_in_tcon_top>;
				};
			};
		};
	};

	tcon_lcd0: lcd-controller@6511000 {
		compatible = "allwinner,sun50i-h616-tcon-lcd",
			     "allwinner,sun8i-r40-tcon-lcd";
		reg = <0x06511000 0x1000>;
		interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&ccu CLK_BUS_TCON_LCD0>, <&ccu CLK_TCON_LCD0>;
		clock-names = "ahb", "tcon-ch0";
		clock-output-names = "tcon-data-clock";
		#clock-cells = <0>;
		resets = <&ccu RST_BUS_TCON_LCD0>, <&ccu RST_BUS_LVDS>;
		reset-names = "lcd", "lvds";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * These two can stay unnumbered: nothing reads their
			 * reg. It is the endpoint on the far side, in
			 * tcon_top's output port, that encodes the TCON index
			 * -- see the note there before removing any reg.
			 */
			tcon_lcd0_in: port@0 {
				reg = <0>;

				tcon_lcd0_in_tcon_top_mixer0: endpoint {
					remote-endpoint = <&tcon_top_mixer0_out_tcon_lcd0>;
				};
			};

			tcon_lcd0_out: port@1 {
				reg = <1>;

				tcon_lcd0_out_lcd: endpoint {
					remote-endpoint = <&panel_in_rgb>;
				};
			};
		};
	};

	/*
	 * TCON TV0 -- the timing controller HDMI scans out of. TCON2 in
	 * TCON_TOP_PORT_SEL's numbering, which is what the reg = <2> on
	 * tcon_top's output endpoint above encodes.
	 *
	 * Its compatible has no fallback on purpose: "allwinner,sun8i-r40-
	 * tcon-tv" would match a quirk set without hdmi_pad, and H616 needs
	 * SUN4I_TCON_GCTL_PAD_SEL set for the TCON's output to reach the
	 * HDMI transmitter at all. patches/linux/0100 adds the H616 quirks
	 * that do set it; without that patch this node simply does not bind.
	 *
	 * "tcon-ch1" comes from tcon_top rather than the CCU: TCON TOP owns
	 * the TV0 clock gate and re-exports it, which is why tcon_top
	 * carries #clock-cells and clock-output-names.
	 */
	tcon_tv0: lcd-controller@6515000 {
		compatible = "allwinner,sun50i-h616-tcon-tv";
		reg = <0x06515000 0x1000>;
		interrupts = <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&ccu CLK_BUS_TCON_TV0>,
			 <&tcon_top CLK_TCON_TOP_TV0>;
		clock-names = "ahb", "tcon-ch1";
		resets = <&ccu RST_BUS_TCON_TV0>;
		reset-names = "lcd";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * One input endpoint, not two. sun4i_tcon_find_engine()
			 * takes a different path when a TCON's input port has
			 * more than one child: it stops traversing the graph
			 * and matches engine ids against the TCON's index in
			 * the driver's list instead. With one mixer and two
			 * TCONs the second lookup would ask for engine id 1,
			 * find nothing, and fail the whole component master --
			 * which is the panel as well as HDMI. So both TCONs
			 * keep exactly one input endpoint and both resolve to
			 * mixer0 by traversal.
			 */
			tcon_tv0_in: port@0 {
				reg = <0>;

				tcon_tv0_in_tcon_top_mixer0: endpoint {
					remote-endpoint = <&tcon_top_mixer0_out_tcon_tv0>;
				};
			};

			tcon_tv0_out: port@1 {
				reg = <1>;

				tcon_tv0_out_tcon_top: endpoint {
					remote-endpoint = <&tcon_top_hdmi_in_tcon_tv0>;
				};
			};
		};
	};
};

&pio {
	/*
	 * Bank D carries the parallel RGB pins. The other banks already get
	 * their supply in rg35xx-2024.dts; PD was left out because nothing
	 * used it until now, and without it the pinmux below cannot drive
	 * anything.
	 */
	vcc-pd-supply = <&reg_cldo3>;

	lcd0_rgb888_pins: lcd0-rgb888-pins {
		pins = "PD0", "PD1", "PD2", "PD3",
		       "PD4", "PD5", "PD6", "PD7",
		       "PD8", "PD9", "PD10", "PD11",
		       "PD12", "PD13", "PD14", "PD15",
		       "PD16", "PD17", "PD18", "PD19",
		       "PD20", "PD21", "PD22", "PD23",
		       "PD24", "PD25", "PD26", "PD27";
		function = "lcd0";
	};

	/*
	 * The analog multiplexer's enable, driven low by being configured as
	 * an output. Referenced by the adc-joystick node rather than by the
	 * mux, which is where mainline's rg35xx-h.dts puts it too: the mux
	 * consumer is what needs the signal path alive.
	 */
	joy_mux_pin: joy-mux-pin {
		pins = "PI0";
		function = "gpio_out";
	};
};

/*
 * The display engine needs a slice of SRAM C. 6.18.44's sunxi_sram has
 * no H616-specific section descriptor, so the a64 fallback compatible is
 * what actually matches; the H616 string is there for the day it gains
 * one.
 */
&sram_c {
	de3_sram: sram-section@0 {
		compatible = "allwinner,sun50i-h616-sram-c",
			     "allwinner,sun50i-a64-sram-c";
		reg = <0x0000 0x1e000>;
	};
};

/*
 * vdd-dram at LPDDR3's nominal 1.2 V, overriding the 1.1 V inherited from
 * rg35xx-plus.dts.
 *
 * The inherited value is an LPDDR4 rail voltage, and this unit's memory is
 * LPDDR3. 1.2 V is what Anbernic's own firmware runs: booting muOS on this unit
 * reads dcdc3 = 1200000 uV, with dcdc2 = 940000 confirming the rail numbering.
 * See docs/dram-verification.md.
 *
 * This must stay equal to CONFIG_AXP_DCDC3_VOLT in uboot/uboot.defconfig, and
 * tools/check-consistency.sh asserts that. The SPL programs the PMIC before
 * DRAM training, so the defconfig decides what training runs at; this node
 * decides what Linux leaves the rail at. Raising one without the other trains
 * at one voltage and runs at the other, which is worse than either alone --
 * the inherited node pins min == max with regulator-always-on, so the kernel
 * really does force it back.
 *
 * Addressed by path because this label is not in the DTB's symbol table and
 * was never verified; the path came out of the built DTB.
 */
&{/soc/i2c@7081400/pmic@34/regulators/dcdc3} {
	regulator-min-microvolt = <1200000>;
	regulator-max-microvolt = <1200000>;
};
