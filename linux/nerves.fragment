#
# Kernel configuration deltas for Nerves on the Anbernic RG40XXV.
#
# This fragment is the reviewable artifact; linux/linux-6.18.defconfig is
# its output. Regenerate with tools/gen-kernel-defconfig.sh, which does:
#
#   make ARCH=arm64 defconfig
#   scripts/kconfig/merge_config.sh -m .config linux/nerves.fragment
#   make ARCH=arm64 olddefconfig savedefconfig
#
# The base is the stock arm64 defconfig rather than a hand-rolled minimal
# config, because that is the configuration the RG35XX-family device trees
# were developed and tested against upstream. It carries more drivers than
# this device needs; trimming it is follow-on work, and the rootfs
# partitions in fwup_include/fwup-common.conf are sized accordingly.
#

#
# Nerves requirements
#

# Root filesystem is a read-only squashfs, application data is f2fs.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_F2FS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# erlinit runs as PID 1 straight out of the squashfs; there is no initramfs.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_BLK_DEV_INITRD is not set

# Nerves reads input devices through evdev.
CONFIG_INPUT_EVDEV=y

# Required by vintage_net, which gives every interface its own routing table so
# it can prioritise them. Without these, `ip route add ... table 102` fails with
# "RTNETLINK answers: Operation not supported", VintageNet.RouteManager crashes,
# and the interface is torn down moments after DHCP succeeds -- WiFi associates,
# gets a lease, then deauthenticates in a loop and is never reachable.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# Swap on compressed RAM. 1 GB is not a lot for the BEAM plus a page cache.
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y

#
# Anbernic RG40XXV hardware
#

# AXP717 PMIC: regulators, ADC, and the battery/USB power supplies that
# make System.cmd("cat", ["/sys/class/power_supply/..."]) useful. The
# regulator and MFD halves are already in the arm64 defconfig; the power
# supply drivers are not.
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_AXP20X_ADC=y
CONFIG_AXP20X_POWER=y
CONFIG_BATTERY_AXP20X=y

# RTL8821CS: SDIO WiFi and UART Bluetooth.
CONFIG_RTW88=m
CONFIG_RTW88_8821CS=m
# BT stays a module: it can't be built in while RFKILL is a module, and
# nothing needs Bluetooth before the application starts anyway.
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_RTL=y

# The H700's SID eFuse, read by boardid for the hostname.
CONFIG_NVMEM_SUNXI_SID=y

# Audio. The codec@5096000 node the board DTS enables is
# "allwinner,sun50i-h616-codec", which sun4i-codec.c drives -- and which the
# arm64 defconfig does not enable.
CONFIG_SND_SUN4I_CODEC=m

# Display. The pipeline is mixer0 -> tcon_top -> tcon_lcd0 -> panel; the
# nodes are in linux/sun50i-h700-anbernic-rg40xx-v.dts and the drivers that
# 6.18.44 is missing are in patches/linux/0100..0103.
#
# DRM, DRM_SUN4I, DRM_SUN8I_MIXER and DRM_SUN8I_TCON_TOP are already enabled
# by the arm64 defconfig, and savedefconfig omits the latter two because they
# default to DRM_SUN4I. They are checked by tools/gen-kernel-defconfig.sh
# against the full .config rather than the savedefconfig for that reason.
CONFIG_SUN50I_DE2_BUS=y
# The panel is initialised over bit-banged three-wire SPI on PI8/PI9/PI10.
# There is no hardware SPI controller wired to it, so spi-gpio is not
# optional.
CONFIG_SPI_GPIO=y
# The generic panel driver from patches/linux/0101. It reads this panel's
# timings and init sequence from firmware at probe time; DRM_PANEL_MIPI
# depends on BACKLIGHT_CLASS_DEVICE and selects DRM_MIPI_DBI.
#
# Built in, with the panel description linked into the kernel image.
#
# This was a module until 2026-08-17, and the reason is worth keeping because
# the obvious fix for it is wrong. request_firmware() runs at probe, which for
# a built-in driver is during initcalls -- before the kernel mounts the root
# filesystem in prepare_namespace(). Building it in while the blob sat in
# /lib/firmware was tried and failed exactly there: "Direct firmware load for
# panels/... failed with error -2" at 1.7 s and no /sys/class/drm/card0 at all.
# ROCKNIX gets away with building it in because Batocera ships an initramfs;
# this system deliberately has none (CONFIG_BLK_DEV_INITRD is unset, so erlinit
# is PID 1 straight out of the squashfs).
#
# CONFIG_EXTRA_FIRMWARE is the answer to precisely that failure: it links the
# blob into the image, so request_firmware() is satisfied from the built-in
# table with no filesystem involved. The earlier experiment was not "built-in
# does not work" but "built-in without embedding does not work".
#
# What this buys, measured on hardware before the change:
#
#     5.73s  /root mounted
#     7.10s  the BEAM starts
#     9.47s  panel-mipi binds
#     10.27s console switches to the framebuffer
#
# As a module the panel could not appear until userspace had mounted a
# filesystem and modprobed it, which put the first possible pixel about ten
# seconds in. Built in, probe happens during initcalls.
#
# Autoloading is no longer a consideration, but the note is kept because it is
# the reason this cannot simply go back to being a module that loads itself:
# the SPI core derives a modalias from the first compatible string minus its
# vendor prefix, so this panel announces itself as "spi:rg40xx-v2-panel" while
# the driver advertises panel-mipi-dpi-spi, and nothing matches. Reordering the
# compatible strings is not an option -- the driver builds the firmware
# filename out of the first one. Built in, none of that applies: the SPI core
# matches on of_match_table, which does contain panel-mipi-dpi-spi.
#
# The blob is copied into the kernel tree by
# patches/buildroot/0002-linux-embed-out-of-tree-firmware, from the directory
# named by BR2_LINUX_KERNEL_EXTRA_FIRMWARE_DIR in nerves_defconfig -- which is
# the same rootfs_overlay directory that installs it to /lib/firmware, so there
# is one copy of the file in the tree and it is used twice.
#
# CONFIG_EXTRA_FIRMWARE_DIR is relative, and the kernel prefixes relative paths
# with $(srctree); "firmware" is the kernel's own default and the directory the
# patch copies into.
# The whole sun4i display stack is built in, not just the panel.
#
# The arm64 defconfig leaves CONFIG_DRM=m, and Kconfig will not let a symbol be
# =y when the subsystem it depends on is =m -- it silently downgrades it back
# to =m instead. Setting only CONFIG_DRM_PANEL_MIPI=y produced exactly that:
# a generated defconfig still saying =m, which would have built a module that
# nothing loads, because this panel cannot autoload. A blank screen.
#
# The component master is the reason the mixer and the TCON come too: sun4i's
# display-engine cannot complete binding until every component has registered,
# so a built-in panel waiting on a modular mixer would gain nothing.
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_PANEL_MIPI=y
CONFIG_EXTRA_FIRMWARE="panels/anbernic,rg40xx-v2-panel.panel"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=m

# Put the kernel log on the panel.
#
# This is the point of the exercise as much as graphics are: the device has no
# usable console -- UART0 is on internal test pads -- so until now the only
# way to see why a boot failed was to read raw card sectors. With fbdev
# emulation plus fbcon, and console=tty0 on the kernel command line in
# rootfs_overlay/boot/extlinux/, panics and driver errors land on the screen.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Mali GPU. DRM_PANFROST is already enabled by the arm64 defconfig and the
# module does load -- but it never binds, and the reason is not in the GPU
# node. That node is status = "okay" and its mali-supply resolves to the
# PMIC's dcdc2, which is registered and healthy as vdd-gpu-sys. What is
# missing is the other dependency: power-domains points at
# /soc/power-controller@7010250, compatible "allwinner,sun50i-h616-prcm-ppu",
# and nothing in this kernel provides that compatible. So the probe defers
# until it times out:
#
#   panfrost 1800000.gpu: deferred probe timeout, ignoring dependency
#   panfrost 1800000.gpu: probe with driver panfrost failed with error -110
#
# The visible symptom is subtle: there is still a card0, because that is
# sun4i-drm, and the panel works normally. What is absent is the render node
# -- no /dev/dri/renderD128 -- and with it every GLES userspace, which is what
# Mesa, RetroArch and any GPU-backed toolkit need.
#
# SUN50I_H6_PRCM_PPU is the driver for that compatible; its Kconfig help says
# outright that it is "required to enable the Mali GPU in the H616 SoC".
# Built in rather than a module because panfrost's probe is what waits on it,
# and deferred probe gives up after 30 s.
CONFIG_SUN50I_H6_PRCM_PPU=y

# USB gadget. Mainline sets usbotg to dr_mode = "peripheral", so the USB-C
# port can present a network interface and a serial console -- the primary
# way onto this device, since it has no pin header. The gadget itself is
# composed at runtime via configfs; see README.
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_GADGET=y

# exFAT, for the second card slot.
#
# The games card that goes in that slot is formatted exFAT -- that is what
# muOS puts there -- and the arm64 defconfig has no exFAT at all: before
# this, /proc/filesystems on the device listed vfat, ext4 and f2fs and
# nothing else. The slot itself is enabled by &mmc2 in
# linux/sun50i-h700-anbernic-rg40xx-v.dts; this is the other half.
#
# Built in rather than a module, because the thing being fixed is a missing
# line in /proc/filesystems, and a module only appears there once it has
# been loaded. Nothing here mounts the card -- that is the application's
# job -- so there is no load step to hang the module off, and this system
# has no initramfs to autoload from either.
#
# No NLS symbol is needed with it, which is worth writing down because the
# opposite is widely assumed. fs/exfat/Kconfig `select NLS` already, and
# CONFIG_EXFAT_DEFAULT_IOCHARSET defaults to "utf8" -- and utf8 is the one
# charset exFAT does NOT resolve through NLS. exfat_fill_super() branches on
# opts->utf8 and installs exfat_utf8_dentry_ops directly; load_nls() is only
# reached in the else arm, for an explicit non-utf8 iocharset= mount option
# (fs/exfat/super.c). CONFIG_NLS_CODEPAGE_437 is already set by the arm64
# defconfig and covers that case anyway.
CONFIG_EXFAT_FS=y
