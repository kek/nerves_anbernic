From: nerves_anbernic <none@example.com>
Subject: [PATCH] mfd: axp20x: power off the AXP717 via SOFT_PWROFF (0x27)

axp20x_power_off() writes AXP20X_OFF_CTRL (0x32) for every variant without a
dedicated case, and the AXP717/AXP2202 register map has no 0x32 at all -- it
jumps from 0x30 (I2C_CFG) to 0x3e (BUS_MODE_SEL) -- so on the Anbernic
RG40XXV the write is silently dropped and shutdown falls through to PSCI
SYSTEM_OFF. The ATF this board boots has no driver for this PMIC either, so
SYSTEM_OFF parks the CPU, the watchdog runs out, and "power off" is
indistinguishable from a reboot: the observed symptom that led here.

The AXP717's real soft power-off is SOFT_PWROFF (0x27) bit 0, per the vendor
BSP header (AXP2202_SOFT_PWROFF) and U-Boot's AXP717 SPL support
(AXP_SHUTDOWN_REG 0x27 / AXP_SHUTDOWN_MASK BIT(0)); the same fix ships in the
TrimUI and OrangePi 4A mainline patch sets for other AXP717 boards. Set that
bit with a read-modify-write -- bits 2-3 of the register hold power-on
configuration -- and add the register to the writeable range so regmap does
not filter the write. The switch is restructured so each variant does its own
write, because the AXP717 needs a different value as well as a different
register and threading both through the shared write bought nothing.

Still absent upstream as of 6.19-rc: the same default-case write is in
mainline's axp20x_power_off() today, so this is a candidate for submission
rather than a backport.

diff --git a/drivers/mfd/axp20x.c b/drivers/mfd/axp20x.c
index c5f0eba..49304e9 100644
--- a/drivers/mfd/axp20x.c
+++ b/drivers/mfd/axp20x.c
@@ -222,6 +222,7 @@ static const struct regmap_range axp717_writeable_ranges[] = {
 	regmap_reg_range(AXP717_PMU_FAULT, AXP717_MODULE_EN_CONTROL_1),
 	regmap_reg_range(AXP717_MIN_SYS_V_CONTROL, AXP717_BOOST_CONTROL),
 	regmap_reg_range(AXP717_VSYS_V_POWEROFF, AXP717_VSYS_V_POWEROFF),
+	regmap_reg_range(AXP717_SOFT_PWROFF, AXP717_SOFT_PWROFF),
 	regmap_reg_range(AXP717_IRQ0_EN, AXP717_IRQ4_EN),
 	regmap_reg_range(AXP717_IRQ0_STATE, AXP717_IRQ4_STATE),
 	regmap_reg_range(AXP717_TS_PIN_CFG, AXP717_TS_PIN_CFG),
@@ -1238,20 +1239,33 @@ static const struct mfd_cell axp_regulator_only_cells[] = {
 static int axp20x_power_off(struct sys_off_data *data)
 {
 	struct axp20x_dev *axp20x = data->cb_data;
-	unsigned int shutdown_reg;
 
 	switch (axp20x->variant) {
 	case AXP323_ID:
 	case AXP313A_ID:
-		shutdown_reg = AXP313A_SHUTDOWN_CTRL;
+		regmap_write(axp20x->regmap, AXP313A_SHUTDOWN_CTRL, AXP20X_OFF);
+		break;
+	case AXP717_ID:
+		/*
+		 * The AXP717/AXP2202 register map has no 0x32 (it jumps from
+		 * 0x30 I2C_CFG to 0x3e BUS_MODE_SEL), so the generic write
+		 * below is silently dropped and shutdown falls through to
+		 * PSCI SYSTEM_OFF, which firmware without a driver for this
+		 * PMIC cannot honour. Its real soft power-off is SOFT_PWROFF
+		 * (0x27) bit 0, per the vendor BSP header
+		 * (AXP2202_SOFT_PWROFF) and U-Boot's AXP717 SPL support.
+		 * Read-modify-write: bits 2-3 of the same register hold
+		 * power-on configuration.
+		 */
+		regmap_update_bits(axp20x->regmap, AXP717_SOFT_PWROFF,
+				   AXP717_SOFT_PWROFF_EN,
+				   AXP717_SOFT_PWROFF_EN);
 		break;
 	default:
-		shutdown_reg = AXP20X_OFF_CTRL;
+		regmap_write(axp20x->regmap, AXP20X_OFF_CTRL, AXP20X_OFF);
 		break;
 	}
 
-	regmap_write(axp20x->regmap, shutdown_reg, AXP20X_OFF);
-
 	/* Give capacitors etc. time to drain to avoid kernel panic msg. */
 	mdelay(500);
 
diff --git a/include/linux/mfd/axp20x.h b/include/linux/mfd/axp20x.h
index 3c5aecf..c430f03 100644
--- a/include/linux/mfd/axp20x.h
+++ b/include/linux/mfd/axp20x.h
@@ -127,6 +127,8 @@ enum axp20x_variants {
 #define AXP717_MODULE_EN_CONTROL_2	0x19
 #define AXP717_BOOST_CONTROL		0x1e
 #define AXP717_VSYS_V_POWEROFF		0x24
+#define AXP717_SOFT_PWROFF		0x27
+#define AXP717_SOFT_PWROFF_EN		BIT(0)
 #define AXP717_IRQ0_EN			0x40
 #define AXP717_IRQ1_EN			0x41
 #define AXP717_IRQ2_EN			0x42
