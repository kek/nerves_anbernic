drm/sun4i: add H616 TCON LCD, TCON TV and display-engine support

Taken from ROCKNIX's 0002-rg35xx-enable-HDMI-LCD.patch, which is Jernej
Skrabec's H616 display series as carried downstream. Only the TCON half is
kept here; see the note below.

Upstream status: not upstream as of 6.18.44. The mixer and DE33 clock halves
of that series ARE already upstream (allwinner,sun50i-h616-de33-mixer-0 and
allwinner,sun50i-h616-de33-clk both exist in 6.18.44), so they are dropped
from this patch. ROCKNIX additionally carries a newer refactor of Jernej's
that moves plane handling out of the mixer into a separate sun50i_planes
driver; that is deliberately NOT taken, because 6.18.44 already implements
DE33 planes inside the mixer and mixing the two designs would mean reverting
working upstream code. The consequence for the device tree is that the mixer
node must use upstream's binding -- reg-names = "layers", "top", "display" --
rather than ROCKNIX's separate planes@ node.

What is genuinely missing from 6.18.44 and therefore kept:

  * allwinner,sun50i-h616-tcon-lcd and -tcon-tv quirks in sun4i_tcon.c/.h.
    6.18.44's TCON driver knows nothing about H616, so without this the
    lcd-controller node never binds and there is no CRTC.
  * allwinner,sun50i-h616-display-engine in sun4i_drv.c, without which the
    display-engine node does not match and no DRM device is created at all.
  * The TCON TOP clock indices in include/dt-bindings/clock/sun8i-tcon-top.h,
    referenced by the tcon_tv0 node.

The board and SoC device tree nodes from the original patch are not here.
They live in linux/sun50i-h700-anbernic-rg40xx-v.dts as ordinary source, so
that a kernel bump does not turn them into a rejected hunk.
diff --git a/drivers/gpu/drm/sun4i/sun4i_tcon.c b/drivers/gpu/drm/sun4i/sun4i_tcon.c
index 960e83c8291d..5d6c7d08cf8f 100644
--- a/drivers/gpu/drm/sun4i/sun4i_tcon.c
+++ b/drivers/gpu/drm/sun4i/sun4i_tcon.c
@@ -1284,6 +1284,11 @@ static int sun4i_tcon_bind(struct device *dev, struct device *master,
 				   tcon->id);
 	}
 
+	if (tcon->quirks->hdmi_pad)
+		regmap_update_bits(tcon->regs, SUN4I_TCON_GCTL_REG,
+				   SUN4I_TCON_GCTL_PAD_SEL,
+				   SUN4I_TCON_GCTL_PAD_SEL);
+
 	list_add_tail(&tcon->list, &drv->tcon_list);
 
 	return 0;
@@ -1542,6 +1547,13 @@ static const struct sun4i_tcon_quirks sun20i_d1_lcd_quirks = {
 	.set_mux		= sun8i_r40_tcon_tv_set_mux,
 };
 
+static const struct sun4i_tcon_quirks sun50i_h616_tv_quirks = {
+	.has_channel_1		= true,
+	.polarity_in_ch0	= true,
+	.hdmi_pad		= true,
+	.set_mux		= sun8i_r40_tcon_tv_set_mux,
+};
+
 /* sun4i_drv uses this list to check if a device node is a TCON */
 const struct of_device_id sun4i_tcon_of_table[] = {
 	{ .compatible = "allwinner,sun4i-a10-tcon", .data = &sun4i_a10_quirks },
@@ -1561,6 +1573,7 @@ const struct of_device_id sun4i_tcon_of_table[] = {
 	{ .compatible = "allwinner,sun9i-a80-tcon-tv", .data = &sun9i_a80_tcon_tv_quirks },
 	{ .compatible = "allwinner,sun20i-d1-tcon-lcd", .data = &sun20i_d1_lcd_quirks },
 	{ .compatible = "allwinner,sun20i-d1-tcon-tv", .data = &sun8i_r40_tv_quirks },
+	{ .compatible = "allwinner,sun50i-h616-tcon-tv", .data = &sun50i_h616_tv_quirks },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, sun4i_tcon_of_table);
diff --git a/drivers/gpu/drm/sun4i/sun4i_tcon.h b/drivers/gpu/drm/sun4i/sun4i_tcon.h
index fa23aa23fe4a..98bee2bd96d2 100644
--- a/drivers/gpu/drm/sun4i/sun4i_tcon.h
+++ b/drivers/gpu/drm/sun4i/sun4i_tcon.h
@@ -19,6 +19,7 @@
 
 #define SUN4I_TCON_GCTL_REG			0x0
 #define SUN4I_TCON_GCTL_TCON_ENABLE			BIT(31)
+#define SUN4I_TCON_GCTL_PAD_SEL				BIT(1)
 #define SUN4I_TCON_GCTL_IOMAP_MASK			BIT(0)
 #define SUN4I_TCON_GCTL_IOMAP_TCON1			(1 << 0)
 #define SUN4I_TCON_GCTL_IOMAP_TCON0			(0 << 0)
@@ -243,6 +244,7 @@ struct sun4i_tcon_quirks {
 	bool    needs_edp_reset; /* a80 edp reset needed for tcon0 access */
 	bool	supports_lvds;   /* Does the TCON support an LVDS output? */
 	bool	polarity_in_ch0; /* some tcon1 channels have polarity bits in tcon0 pol register */
+	bool	hdmi_pad;	/* h616 has to enable pad for HDMI */
 	u8	dclk_min_div;	/* minimum divider for TCON0 DCLK */
 
 	/* callback to handle tcon muxing options */
-- 
