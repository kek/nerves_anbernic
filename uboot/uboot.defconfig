# U-Boot configuration for the Anbernic RG40XXV (Allwinner H700)
#
# The PMIC and SPL status LED settings are taken verbatim from upstream's
# configs/anbernic_rg35xx_h700_defconfig. The DRAM block is NOT -- see the
# comment on it below; upstream's LPDDR4 timings do not work on this board.
# There is no RG40XXV defconfig upstream. The rest adds what
# Nerves needs: an environment block on the MicroSD that both U-Boot and
# Elixir can read, and sysboot/squashfs so U-Boot can read
# extlinux-{a,b}.conf straight out of the active rootfs partition.
#
# Read "taken verbatim from upstream" as a warning rather than as provenance.
# The file it was copied from is an *LPDDR4* defconfig. The DRAM half of that
# copy did not work on this board and was replaced; the PMIC half was not
# reconsidered at the time, and one value in it turns out to be
# memory-type-dependent too -- see the note on CONFIG_AXP_DCDC3_VOLT below.

CONFIG_ARM=y
CONFIG_ARCH_SUNXI=y
CONFIG_MACH_SUN50I_H616=y
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h700-anbernic-rg35xx-2024"

#
# DRAM: 1 GB LPDDR3 @ 672 MHz
#
# These are NOT upstream's values. anbernic_rg35xx_h700_defconfig specifies
# CONFIG_SUNXI_DRAM_H616_LPDDR4, and using it here hangs the SPL during DRAM
# init: the SoC stops responding entirely, so it never returns control even to
# a FEL session. This is the one place the "same PCB family as the RG35XX Plus"
# assumption breaks down.
#
# **This unit** has LPDDR3 -- not the model, and not the family. ROCKNIX ships
# both an LPDDR3 and an LPDDR4 U-Boot for the H700 and chooses between them per
# unit by reading the vdd-dram regulator, having per-model device-tree IDs
# available and unused. So model identity does not predict the memory type, and
# a second RG40XXV is not covered by anything below. No published Anbernic
# specification names a type at all; the LPDDR4 label that circulates is
# secondhand.
#
# Established four ways, all reproducible: see docs/dram-verification.md, and
# tools/dram-type.sh for the two cheap ones. Source of the values here is the
# vendor boot0 on a muOS card that boots this device -- its dram_para at offset
# 0x38 declares dram_type = 7 (LPDDR3) and carries the drive-strength and ODT
# values below. Two things confirm the struct offset rather than assuming it:
# the 672 MHz clock agrees with upstream, and the eGON checksum over the blob
# verifies, which it cannot do unless the header layout is the documented one.
#
# TPR6 and TPR10 have no default in U-Boot's Kconfig, so they are mandatory --
# omitting them makes Kconfig prompt for a value and the build hangs. The TPR
# values below are read from the same boot0 region (0xa0..0xac), in the order
# TPR6, TPR10, TPR11, TPR12. That ordering is inferred rather than confirmed
# against a struct definition; the supporting evidence is that boot0's
# 0x402f4489 shares the 0x402f prefix with upstream's LPDDR4 TPR10 0x402f6633.
#
# Not set: DRAM_SUNXI_PARA0 (depends on DRAM_SUN50I_A133, so it does not apply
# to the H616 controller) and TPR2, which defaults to 0x0 here rather than the
# 0x1 upstream uses for LPDDR4.
#
CONFIG_DRAM_CLK=672
CONFIG_SUNXI_DRAM_H616_LPDDR3=y
CONFIG_DRAM_SUNXI_DX_ODT=0x06060606
CONFIG_DRAM_SUNXI_DX_DRI=0x0d0d0d0d
CONFIG_DRAM_SUNXI_CA_DRI=0x1919
CONFIG_DRAM_SUNXI_ODT_EN=0x9988eeee
CONFIG_DRAM_SUNXI_TPR6=0x2fb08080
CONFIG_DRAM_SUNXI_TPR10=0x402f4489
CONFIG_DRAM_SUNXI_TPR11=0x10121212
CONFIG_DRAM_SUNXI_TPR12=0x0d0e0d0e
CONFIG_DRAM_SUNXI_PHY_ADDR_MAP_1=y

#
# SPL
#
CONFIG_SPL=y
CONFIG_SPL_SUNXI_LED_STATUS=y
CONFIG_SPL_SUNXI_LED_STATUS_GPIO=268
CONFIG_SPL_I2C=y
CONFIG_SPL_SYS_I2C_LEGACY=y

#
# AXP717 PMIC over R_I2C
#
CONFIG_R_I2C_ENABLE=y
CONFIG_SYS_I2C_MVTWSI=y
CONFIG_SYS_I2C_SLAVE=0x7f
CONFIG_SYS_I2C_SPEED=400000
CONFIG_REGULATOR_AXP=y
CONFIG_AXP717_POWER=y
CONFIG_AXP_DCDC2_VOLT=940

# DCDC3 is vdd-dram, at LPDDR3's nominal 1.2 V. It was 1100 until 2026-08-21 --
# inherited verbatim from an LPDDR4 defconfig along with the rest of this PMIC
# block, which is the same mistake as the DRAM timings, caught on that half and
# missed on this one. ROCKNIX's LPDDR3 build programs 1200 into this same PMIC
# on these same boards, and its installer reads 1.1 V here as *meaning* LPDDR4.
#
# The SPL programs the PMIC before DRAM training, so this value is the voltage
# training actually happens at. It must stay equal to the dcdc3 override in
# linux/sun50i-h700-anbernic-rg40xx-v.dts, which is what Linux leaves the rail
# at -- the inherited node pins min == max with regulator-always-on, so raising
# one without the other trains at one voltage and runs at the other.
# tools/check-consistency.sh asserts they agree.
#
# Verified to train before being committed, over FEL and with no rebuild:
# `tools/dram-falsify.sh test lpddr3-vdd1v2` brought DRAM up with two addresses
# 1 MB apart independent. Still to do on hardware is the part FEL cannot show:
# confirm the rail reads 1200000 in sysfs after a burn, then soak it warm.
# docs/dram-verification.md has the sequence.
#
# Undervolted DRAM does not hang. It corrupts rarely, under load and heat --
# which is why "it has always worked at 1.1 V" was never much evidence.
CONFIG_AXP_DCDC3_VOLT=1200

#
# Nerves: environment block on the MicroSD.
#
# Must agree with UBOOT_ENV_OFFSET in fwup_include/fwup-common.conf
# (sector 8192 * 512 = 0x400000) and with rootfs_overlay/etc/fw_env.config.
#
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_SIZE=0x20000
CONFIG_ENV_OFFSET=0x400000
CONFIG_ENV_VARS_UBOOT_CONFIG=y

#
# Nerves: boot the active rootfs via sysboot + extlinux.
#
# DISTRO_DEFAULTS is off because its generated boot logic would fight the
# A/B selection in uboot.env.
#
# CONFIG_DISTRO_DEFAULTS is not set
CONFIG_BOOTDELAY=0
CONFIG_HUSH_PARSER=y
CONFIG_CMD_SYSBOOT=y
CONFIG_CMD_SQUASHFS=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_PART=y
CONFIG_DOS_PARTITION=y
CONFIG_SUPPORT_RAW_INITRD=y
CONFIG_SYS_STDIO_DEREGISTER=y
CONFIG_CMD_WDT=y

#
# Trim things a Nerves device never boots.
#
# CONFIG_CMD_NET is not set
# CONFIG_CMD_BOOTEFI is not set
# CONFIG_CMD_ELF is not set
# CONFIG_BOOTM_NETBSD is not set
# CONFIG_BOOTM_PLAN9 is not set
# CONFIG_BOOTM_RTEMS is not set
# CONFIG_BOOTM_VXWORKS is not set
