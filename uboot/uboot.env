# Custom U-Boot base environment for Nerves on the Anbernic RG40XXV
#
# Why this file exists:
#
#   1. Nerves stores firmware metadata in the U-Boot environment so that
#      both U-Boot and Elixir can read it.
#   2. That means the image needs a real environment block.
#   3. Once U-Boot is pointed at an environment block, that block
#      *replaces* the built-in default environment, including all the
#      logic that boots the board. So the relevant parts have to be
#      copied here.
#
# IMPORTANT: saveenv saves everything. There is no way to save
# selectively, and some saved variables shadow values U-Boot would
# otherwise detect at runtime (ethaddr, board_serial, ...). Moving a
# MicroSD card between two RG40XXVs will carry those with it.
# See https://github.com/nerves-project/nerves_system_bbb/issues/151.

#
# Nerves variables
#

nerves_fw_active=a

# nerves_fw_autovalidate controls whether updates are considered valid
# once applied. If 0, the application must set nerves_fw_validated=1
# itself; if it doesn't before a reboot, the previous firmware runs
# again. If 1, no further action is needed.
#
# 0 here, because 1 makes the A/B revert machinery a no-op: nerves_init
# would mark the new firmware valid on its first boot whether or not the
# system actually came up, so a kernel that fails to boot would leave the
# device stuck and only recoverable by re-flashing the card. On a handheld
# with no console and no reachable UART that is expensive, and it defeats
# the point of shipping kernel changes over `mix upload`.
#
# The rest of the chain is already in place: the fwup upgrade tasks set
# nerves_fw_validated=0 when they apply an update, and nerves_init below
# reverts to the other partition when it sees booted=1 with validated=0.
#
# Something in the image has to do the validating. nerves_runtime's
# StartupGuard does it, and only once every OTP application has started:
#
#     config :nerves_runtime, startup_guard_enabled: true
#
# An application that sets neither that nor Nerves.Runtime.validate_firmware/0
# will revert on every second boot, so enable one of them.
nerves_fw_autovalidate=0

# nerves_fw_validated is 1 if the current boot selection is accepted. It
# is 1 here because this environment is written at provisioning time, so
# it is implicitly valid.
nerves_fw_validated=1

# nerves_fw_booted is 0 for the first boot and 1 for every boot after.
# NOTE: Keep this '0' so that a freshly flashed card exercises the
#       saveenv path early, while it's easy to notice if it fails.
nerves_fw_booted=0

# The Nerves initialization logic.
#
# nerves_init runs at boot (see bootcmd at the bottom). If this isn't the
# first boot and the firmware wasn't validated, it flips to the other
# partition.
nerves_revert=\
    if test ${nerves_fw_active} = "a"; then\
        echo "Reverting to partition B";\
        setenv nerves_fw_active "b";\
    else\
        echo "Reverting to partition A";\
        setenv nerves_fw_active "a";\
    fi

nerves_init=\
    if test ${nerves_fw_booted} = 1; then\
        if test ${nerves_fw_validated} = 0; then\
            run nerves_revert;\
            setenv nerves_fw_validated 1;\
            saveenv;\
        fi;\
    else\
        setenv nerves_fw_booted 1;\
        if test ${nerves_fw_autovalidate} = 1; then\
            setenv nerves_fw_validated 1;\
        fi;\
        saveenv;\
    fi;\
    if test ${nerves_fw_active} = "a"; then\
        setenv uenv_part 2;\
    else\
        setenv uenv_part 3;\
    fi

#
# Allwinner H700 / sunxi arm64 values, normally supplied by U-Boot's
# built-in environment. Taken from include/configs/sunxi-common.h with
# CONFIG_ARM64 set and SDRAM_OFFSET(x) == 0x4##x.
#

devtype=mmc
devnum=0

kernel_addr_r=0x40080000
kernel_comp_addr_r=0x44000000
kernel_comp_size=0xb000000
fdt_addr_r=0x4FA00000
scriptaddr=0x4FC00000
fdtoverlay_addr_r=0x4FE00000
ramdisk_addr_r=0x4FF00000

# Boot the active rootfs. sysboot reads
# /boot/extlinux/extlinux-{a,b}.conf out of the squashfs itself, which is
# also where the kernel Image and our device tree live.
uname_boot=sysboot ${devtype} ${devnum}:${uenv_part} any ${scriptaddr} /boot/extlinux/extlinux-${nerves_fw_active}.conf

bootcmd=run nerves_init uname_boot
