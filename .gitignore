# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Ignore our generated files
/build.log
/archive.log
/.nerves

# The artifact tarball `mix nerves.artifact` writes here before it is uploaded
# to a GitHub release. Half a gigabyte, reproducible from the build, and its
# name carries the checksum -- so it is output, not source. Named specifically
# rather than *.tar.gz so nothing else gets hidden by accident.
#
# Not in package_files(), so this line does not move the artifact checksum.
/nerves_system_rg40xxv-portable-*.tar.gz
